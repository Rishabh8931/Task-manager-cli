{
  "name": "task-cli",
  "version": "1.0.0",
  "description": "A lightweight CLI task manager built in TypeScript",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prepublishOnly": "pnpm build"
  },
